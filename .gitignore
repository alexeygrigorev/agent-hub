node_modules/
# The symlink form created by scripts/local-dependencies.py in fresh checkouts.
node_modules
dist/
.wrangler/
.dev.vars
.local/
__pycache__/
*.pyc

# Private launcher telemetry and validation evidence
*-telemetry.jsonl
evidence.log
host/*.egg-info/
host/build/

# Generated Hub CLI bundle (rebuilt by head before deploy; never commit).
