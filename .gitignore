public/cli/hub.pyz
public/cli/hub.pyz.sha256
public/cli/manifest.json

# uv project environment
.venv/

# CLI artifacts built into the Hub2 static asset root by the VM installer.
hub2/public/cli/
hub2/host/build/
hub2/host/*.egg-info/
