[Unit]
Description=Agent Hub Hub2 heartbeat cycle
After=network-online.target
Wants=network-online.target

# The persistent Hub2 host service owns the WebSocket and session work. This
# bounded cycle refreshes the enrolled machine heartbeat through Hub2 without
# fetching or claiming offers, reconciling native sessions, or writing the
# response body to the journal.

[Service]
Type=oneshot
WorkingDirectory=%h
UMask=0077
ExecStart=%h/.local/share/agent-hub2/venv/bin/hub2 heartbeat --aplexer a
StandardOutput=null
TimeoutStartSec=60
TimeoutStopSec=10
MemoryMax=256M

[Install]
WantedBy=default.target
