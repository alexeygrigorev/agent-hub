[Unit]
Description=Agent Hub hub2 server (Node runtime, SQLite on machine)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alexey
Group=alexey
UMask=0077
WorkingDirectory=/opt/agent-hub
Environment=NODE_ENV=production
Environment=TMPDIR=/opt/agent-hub/.local/tmp
Environment=HOME=/home/alexey
ExecStart=/usr/bin/node --experimental-transform-types hub2/node/main.ts --host 127.0.0.1 --port 8787 --data-dir /var/lib/agent-hub/hub2-db --dev-vars /opt/agent-hub/.dev.vars --cli-release-root /var/lib/agent-hub/cli-releases
Restart=on-failure
RestartSec=10
KillMode=mixed
TimeoutStopSec=45
MemoryMax=1200M
TasksMax=512
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
