[Unit]
Description=Independently check Hub health and quota publication

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/bin/python3 %h/.local/lib/agent-hub-quota-publisher/current/hub-quota-publish.py --check --health-check --health-config %h/.config/agent-hub/v2.json --health-timeout 8 --alert-timeout 8
TimeoutStartSec=45s
