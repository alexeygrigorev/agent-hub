[Unit]
Description=Agent Hub native session host supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
UMask=0077
WorkingDirectory=%h/git/agent-hub
Environment=PATH=/home/alexey/.local/bin:/home/alexey/.nvm/versions/node/v24.13.1/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/git/agent-hub/scripts/session-host-supervisor.py --workspace %h/git/agent-hub --config %h/.config/agent-hub/subscriptions.json --credential-config %h/.config/agent-hub/host.json --journal-dir %h/git/agent-hub/.local/platform-runtime/journal
Restart=on-failure
RestartSec=10
KillMode=process
TimeoutStopSec=60
MemoryMax=1500M
TasksMax=256

[Install]
WantedBy=default.target
