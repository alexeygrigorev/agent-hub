# Hub2 DB backup config (GCP VM). Copy #2 is a second local tree until the
# Hetzner/Storagebox redundancy is provisioned (docs/GCP-PORT.md checklist).
HUB2_DB_DIR=/var/lib/agent-hub/hub2-db
BACKUP_DIR=/var/backups/hub-do
MIRROR_DIR=/var/backups/hub-do-mirror
RETENTION_DAYS=30
LOCK_FILE=/var/lib/hub2-db-backup/hub2-db-backup.lock
STATE_DIR=/var/lib/hub2-db-backup
ALERT_CMD=/usr/local/sbin/hub-db-backup-staleness.sh
