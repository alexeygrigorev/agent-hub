[Unit]
Description=Check Resource Gate, desktop grant path, and Hub API uptime
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=alexey
Group=alexey
ExecStart=/usr/local/sbin/resource-gate-monitor.sh
Environment=DATAOPS_BIN=/home/alexey/.local/bin/dataops
Environment=DATAOPS_CONFIG_DIR=/home/alexey/.config/dataops
Environment=AGENT_BROWSER_REMOTE_CONFIG=/home/alexey/.agent-browser/remotes.json
Environment=NVM_DIR=/home/alexey/.nvm
TimeoutStartSec=120
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/resource-gate-monitor
