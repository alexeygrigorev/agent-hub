+        if (parsed.error) return parsed.error;
+        const body = parsed.data!;
+        const allowedKeys = new Set(['actor', 'member']);
+        for (const k of Object.keys(body)) {
+          if (!allowedKeys.has(k)) {
+            return jsonResponse({ error: 'unknown_fields', field: k }, 400);
+          }
