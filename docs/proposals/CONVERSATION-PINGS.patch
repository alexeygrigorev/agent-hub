+    id: string;
+    token: string;
+    actor: string;
+    subject?: string;
+    machineId?: string | null;
+    scopes?: string[];
+    expiresAt?: string;
+    revokedAt?: string | null;
+  },
+) {
+  const hash = await sha256(opts.token);
+  const nowIso = new Date(start).toISOString();
+  sql.exec(
+    `INSERT INTO credentials (id, kind, token_hash, family_id, subject, actor, machine_id, scopes, created_by_sub, created_at, expires_at, revoked_at, registry_actor)
+     VALUES (?, 'agent', ?, ?, ?, ?, ?, ?, 'alice', ?, ?, ?, ?)`,
+    opts.id,
+    hash,
+    'fam-' + opts.id,
+    opts.subject ?? opts.actor,
+    opts.actor,
+    opts.machineId ?? 'machine-A',
+    JSON.stringify(opts.scopes ?? ['bus:read', 'bus:send']),
+    nowIso,
+    opts.expiresAt ?? new Date(start + 365 * 86400_000).toISOString(),
+    opts.revokedAt ?? null,
+    opts.actor,
+  );
