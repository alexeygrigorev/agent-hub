+                       'XDG_RUNTIME_DIR': '/wrong-unix-runtime', 'XDG_STATE_HOME': '/wrong-unix-state'}
+        fake_os = types.SimpleNamespace(name='nt', path=ntpath, environ=environment)
+        with patch.object(bridge, 'os', fake_os):
