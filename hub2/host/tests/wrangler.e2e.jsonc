{
  "name": "agent-hub2-host-e2e",
  "main": "e2e-worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_als"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "CONTROL", "class_name": "ControlDO" },
      { "name": "PROJECTS", "class_name": "ProjectDO" },
      { "name": "MACHINES", "class_name": "MachineDO" },
      { "name": "ACCOUNTS", "class_name": "AccountDO" },
      { "name": "MAILBOXES", "class_name": "MailboxDO" }
    ]
  },
  "migrations": [{ "tag": "hub2-e2e-v1", "new_sqlite_classes": ["ControlDO", "ProjectDO", "MachineDO", "AccountDO", "MailboxDO"] }],
  "vars": { "HUB2_DEFAULT_ACCOUNT_ID": "e2e-muse", "HUB2_ENGINE_ACCOUNTS": "{\"opencode\":\"e2e-muse\"}" }
}
