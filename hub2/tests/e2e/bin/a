#!/usr/bin/env python3
"""Stub aplexer `a` for the Hub2 start-path e2e test.

Implements start/status/list/kill/capture/whoami/task run over $APLEXER_STATE_DIR with
the JSON shapes captured from the real binary (fixtures/aplexer.json). The
workload really runs as a detached child process, so kill, exit codes and
captured output are genuine; only cgroups, PTYs and the resident daemon are
left out. It never calls the real `a`.
"""
import json
import os
import signal
import subprocess
import sys
import time
import uuid
from pathlib import Path

STATE = Path(os.environ.get("APLEXER_STATE_DIR") or sys.exit("stub a: APLEXER_STATE_DIR required"))
SESSIONS = STATE / "stub-sessions"
FIXTURE = json.loads((Path(__file__).resolve().parents[1] / "fixtures" / "aplexer.json").read_text())


def now_ms():
    return int(time.time() * 1000)


def write(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".%d.tmp" % os.getpid())
    tmp.write_text(json.dumps(value))
    os.replace(tmp, path)


def records():
    if not SESSIONS.is_dir():
        return []
    out = []
    for path in sorted(SESSIONS.glob("*.json")):
        try:
            out.append(json.loads(path.read_text()))
        except (OSError, ValueError):
            pass
    return out


def resolve(selector):
    rows = records()
    if ":" in selector and not selector.startswith(":"):
        workspace, tag = selector.rsplit(":", 1)
        hits = [r for r in rows if r["tag"] == tag and os.path.realpath(r["workspace"]) == os.path.realpath(workspace)]
    else:
        hits = [r for r in rows if r["id"] == selector or r["id"].startswith(selector)] or \
               [r for r in rows if r["tag"] == selector and os.path.realpath(r["workspace"]) == os.path.realpath(os.getcwd())]
    return hits[0] if len(hits) == 1 else None


def live_view(row):
    row = dict(row)
    if row["phase"] == "running":
        stamp = now_ms()
        row["updated_at_ms"] = stamp
        row["last_activity_ms"] = stamp
    return row


def fail(message, code=1):
    print("error: " + message, file=sys.stderr)
    return code


def take(args, flag, default=None):
    if flag in args:
        index = args.index(flag)
        value = args[index + 1]
        del args[index:index + 2]
        return value
    return default


def control():
    path = STATE / "stub-control.json"
    return json.loads(path.read_text()) if path.exists() else {}


# Profile -> engine binary, as `a profiles` reports them on Hetzner (hub-shared-codex engine=codex).
PROFILE_ENGINES = {"hub-shared-codex": "codex", "hub-shared-go": "opencode", "hub-zai-central": "zcodex",
                   "hub-hub-antigravity": "agy"}


def cmd_task_run(args):
    """`a task run`: prompt file in, engine exec out (worker side of `a start -- a task run ...`)."""
    engine_args = [a.split("=", 1)[1] for a in args if a.startswith("--engine-arg=")]
    args = [a for a in args if not a.startswith("--engine-arg=")]
    while "--engine-arg" in args:
        engine_args.append(take(args, "--engine-arg"))
    profile, engine = take(args, "--profile"), take(args, "--engine")
    cwd, prompt_file = take(args, "--cwd", os.getcwd()), take(args, "--prompt-file")
    binary = PROFILE_ENGINES.get(profile) if profile else engine
    if not binary or not prompt_file:
        return fail("stub a task run: --profile/--engine and --prompt-file required", 2)
    prompt = Path(prompt_file).read_text()
    os.chdir(cwd)
    argv = [binary, "exec", *engine_args, "--dangerously-bypass-approvals-and-sandbox", "--json", prompt]
    os.execvp(binary, argv)


def cmd_start(args):
    child = args[args.index("--") + 1:] if "--" in args else []
    args = args[:args.index("--")] if "--" in args else args
    envs = []
    while "--env" in args:
        envs.append(take(args, "--env"))
    workspace = os.path.realpath(take(args, "--workspace", "."))
    cwd = os.path.realpath(take(args, "--cwd", workspace))
    tag = take(args, "--tag", "main")
    deadline = take(args, "--deadline-ms")
    memory, pids = take(args, "--memory"), take(args, "--pids")
    take(args, "--startup-timeout-ms")
    if not child:
        return fail("stub a start needs -- <command>", 2)
    delay = float(control().get("start_delay_s", 0))
    if delay:
        # Daemon handshake that has not returned yet: no session exists until it does.
        (STATE / "start-pending").write_text(tag)
        time.sleep(delay)
    if resolve(workspace + ":" + tag):
        return fail("tag %s already exists in %s" % (tag, workspace))
    created = now_ms()
    session = str(uuid.uuid4())
    row = {key: value for key, value in FIXTURE["status_running"].items()}
    row.update({
        "id": session, "tag": tag, "workspace": workspace, "cwd": cwd, "command": child,
        "env": dict(item.split("=", 1) for item in envs), "env_unset": [],
        "created_at_ms": created, "updated_at_ms": created, "last_activity_ms": created,
        "deadline_ms": int(deadline) if deadline else None, "phase": "starting", "state": "starting",
        "history_path": str(SESSIONS / (session + ".log")), "socket_path": str(SESSIONS / (session + ".sock")),
        "limits": {"memory": memory, "pids": int(pids) if pids else None},
        "containment_empty": False, "worker_alive": True, "processes": 1,
    })
    write(SESSIONS / (session + ".json"), row)
    subprocess.Popen([sys.executable, __file__, "__supervise", session], start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    until = time.monotonic() + 10
    while time.monotonic() < until:
        current = json.loads((SESSIONS / (session + ".json")).read_text())
        if current["phase"] != "starting":
            print(json.dumps(current))
            return 0
        time.sleep(0.02)
    return fail("startup timeout")


def cmd_supervise(session):
    path = SESSIONS / (session + ".json")
    row = json.loads(path.read_text())
    env = dict(os.environ, **row["env"], APLEXER_SESSION_ID=session)
    log = open(row["history_path"], "ab", buffering=0)
    workload = subprocess.Popen(row["command"], cwd=row["cwd"], env=env, stdin=subprocess.DEVNULL,
                                stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    row.update(phase="running", state="running", worker_pid=os.getpid(), workload_pid=workload.pid)
    write(path, row)
    code = workload.wait()
    row = json.loads(path.read_text())
    exit_info = {"code": code if code >= 0 else None, "exited_at_ms": now_ms(), "oom_killed": False,
                 "signal": -code if code < 0 else None}
    row.update(phase="exited", state="exited", exit=exit_info, containment_empty=True,
               worker_alive=False, processes=0, updated_at_ms=now_ms())
    write(path, row)
    return 0


def cmd_kill(args):
    if not args:
        return fail("session required", 2)
    row = resolve(args[0])
    if not row:
        return fail("no such session")
    path = SESSIONS / (row["id"] + ".json")
    if row["phase"] == "running":
        try:
            os.killpg(row["workload_pid"], signal.SIGHUP)
        except ProcessLookupError:
            pass
        until = time.monotonic() + 5
        while time.monotonic() < until and json.loads(path.read_text())["phase"] != "exited":
            time.sleep(0.05)
        if json.loads(path.read_text())["phase"] != "exited":
            try:
                os.killpg(row["workload_pid"], signal.SIGKILL)
            except ProcessLookupError:
                pass
            time.sleep(0.5)
    row = json.loads(path.read_text())
    if row["phase"] != "exited":
        return fail("workload did not exit")
    tombstone = {key: row.get(key) for key in ("id", "tag", "workspace", "created_at_ms", "exit")}
    tombstone.update(cause="finished", finished_at_ms=now_ms(), containment_empty=True)
    write(STATE / "retired-sessions" / row["id"] / "tombstone.json", tombstone)
    if "--keep-record" not in args:
        path.unlink()
    print(json.dumps({"id": row["id"], "killed": True}) if "--json" in args else "killed " + row["id"])
    return 0


def cmd_capture(args):
    selector = next((a for a in args if not a.startswith("-")), None)
    row = resolve(selector) if selector else None
    if not row:
        return fail("no such session")
    data = Path(row["history_path"]).read_bytes() if Path(row["history_path"]).exists() else b""
    sys.stdout.write(data[-16384:].decode("utf-8", "replace"))
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print("Run, inspect, and switch between durable agent sessions (Hub2 e2e stub)\n\n"
              "Usage: a [OPTIONS] [COMMAND]\n\nCommands: start status list kill capture whoami")
        return 0
    if argv[0] in ("-V", "--version"):
        print("a 0.0.0-hub2-e2e-stub")
        return 0
    command, args = argv[0], list(argv[1:])
    if command == "__supervise":
        return cmd_supervise(args[0])
    if command == "start":
        return cmd_start(args)
    if command == "task" and args[:1] == ["run"]:
        return cmd_task_run(args[1:])
    if command in ("status", "show"):
        selector = next((a for a in args if not a.startswith("-")), None)
        row = resolve(selector) if selector else None
        if not row:
            return fail("no such session")
        print(json.dumps(live_view(row)))
        return 0
    if command in ("list", "ls", "ps", "snapshot"):
        print(json.dumps([live_view(r) for r in records()]))
        return 0
    if command == "kill":
        return cmd_kill(args)
    if command == "capture":
        return cmd_capture(args)
    if command in ("whoami", "current"):
        row = resolve(os.environ.get("APLEXER_SESSION_ID", "")) if os.environ.get("APLEXER_SESSION_ID") else None
        if not row:
            return fail("not inside an aplexer session")
        time.sleep(0.005)
        print(json.dumps(live_view(row)))
        return 0
    return fail("stub a: unsupported command " + command, 2)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
