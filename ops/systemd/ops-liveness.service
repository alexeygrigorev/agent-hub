[Unit]
Description=Liveness check for orchestrator-main and oncall-engineer (alive/not-hung only)

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -n %t/ops-liveness.lock /usr/bin/timeout 900 /usr/bin/nice -n 10 /usr/bin/ionice -c3 %h/.local/share/agent-hub-ops/liveness.sh
Environment=PATH=%h/.local/bin:%h/.nvm/versions/node/v24.13.1/bin:/usr/local/bin:/usr/bin:/bin
Environment=HUB_CONFIG_FILE=%h/.config/agent-hub/host.json
