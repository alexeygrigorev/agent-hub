[Unit]
Description=Restart dead or tick-stalled orchestrator-main / oncall-engineer and prove each restart (no scheduling)

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -n -o %t/ops-watchdog-v2.lock /usr/bin/timeout 900 /usr/bin/nice -n 10 /usr/bin/ionice -c3 %h/.local/share/agent-hub-ops/watchdog.sh
Environment=PATH=%h/.local/bin:%h/.nvm/versions/node/v24.13.1/bin:/usr/local/bin:/usr/bin:/bin
Environment=HUB_CONFIG_FILE=%h/.config/agent-hub/cli.json
Environment=APLEXER_LAUNCH_SYSTEM_SCOPE=system
