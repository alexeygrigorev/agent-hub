[Unit]
Description=Reap labeled test containers by TTL (default 6h) + never-started stopped sessions
After=network-online.target docker.service
[Service]
Type=oneshot
User=alexey
Environment=HOME=/home/alexey
Environment=PATH=/home/alexey/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /usr/local/lib/agent-hub-container-cleanup.py --apply --max-age-hours 6 --hub-bin /home/alexey/.local/bin/hub
