[Unit]
Description=Remove only never-started labeled containers of stopped Hub sessions
After=network-online.target docker.service
[Service]
Type=oneshot
User=alexey
Environment=HOME=/home/alexey
Environment=PATH=/home/alexey/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /usr/local/lib/agent-hub-container-cleanup.py --apply --hub-bin /home/alexey/.local/bin/hub
