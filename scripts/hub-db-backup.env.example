# Hub DB backup env (placeholders only — NEVER real secrets in git).
# Install as /etc/hub-db-backup.env with mode 600 (see install-hub-db-backup.sh).
# Real values live on the operator/Hetzner host only.

# Base URL of the Hub Worker (prod).
HUB_BASE_URL=https://hub.dtcdev.click

# 600 file holding the operator admin token (read by the backup script).
# Default: the existing operator admin-token file on Hetzner.
HUB_ADMIN_TOKEN_FILE=/home/alexey/.config/agent-hub/admin-token

# Hetzner local export tree (OFF Cloudflare copy #1).
BACKUP_DIR=/var/backups/hub-do
# Storagebox mirror (OFF Cloudflare copy #2, sshfs mount).
STORAGEBOX_DIR=/home/alexey/storagebox/backups/hub-do

# Retention floor: prune ONLY copies strictly older than this many days.
# MUST stay >= 30 (AC1). Both trees are pruned independently.
RETENTION_DAYS=30

# Cron-user-owned runtime state (installer creates these owned by alexey;
# root must not run the job: it cannot reach the Storagebox sshfs mount).
LOCK_FILE=/var/lib/hub-db-backup/hub-db-backup.lock
STATE_DIR=/var/lib/hub-db-backup

# Staleness alert (AC2).
STALE_AFTER_HOURS=36
ALERT_TO=alexey@datatalks.club,dev@dtcdev.click
ALERT_FROM=noreply@datatalks.club
ALERT_REPEAT_HOURS=24
# msmtp account used first for the working alerts path on the Hetzner box
# ('ses' delivers noreply@datatalks.club to ALERT_TO; the default account is
# tried as fallback). Override per host if its msmtprc names accounts
# differently.
MSMTP_ACCOUNT=ses

# Fetch timeout per chunk request.
CURL_TIMEOUT=60

# Rows per chunked table read (endpoint caps at 5000). Small enough to keep
# every request far below DO memory even for the fattest production tables.
CHUNK_ROWS=500
