# Hub2 DB backup env for the GCP VM (placeholders — the deployed copy lives
# in /etc/hub2-db-backup.env, mode 600, generated by deploy/gcp-vm-setup.sh).
# No secrets: the database is read locally on the VM.

# wrangler --persist-to dir holding the DO SQLite state.
DO_STATE_DIR=/var/lib/agent-hub/do-state

# Copy #1 (VM local) and copy #2 (mirror tree; switch to a Hetzner/Storagebox
# rsync target once that redundancy is provisioned, see docs/GCP-PORT.md).
BACKUP_DIR=/var/backups/hub-do
MIRROR_DIR=/var/backups/hub-do-mirror

# Retention floor: prune ONLY copies strictly older than this many days.
# MUST stay >= 30 (same AC1 as the hub1 job). Trees are pruned independently.
RETENTION_DAYS=30

LOCK_FILE=/var/lib/hub2-db-backup/hub2-db-backup.lock
STATE_DIR=/var/lib/hub2-db-backup

# Failure alert: invoked as "$ALERT_CMD" --backup-failed "<reason>".
# On the VM the sibling staleness script runs with
# /etc/hub2-db-backup-staleness.env (BACKUP_GLOB=hub2-do-*.tar.gz); mail
# delivery needs the Hetzner redundancy step (the VM has no MTA).
ALERT_CMD=/usr/local/sbin/hub-db-backup-staleness.sh

# Cron (installed by deploy/gcp-vm-setup.sh):
#   20 4 * * * root  /usr/local/sbin/hub2-db-backup.sh >>/var/log/hub2-db-backup.log 2>&1
