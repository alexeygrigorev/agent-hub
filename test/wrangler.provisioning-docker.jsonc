{
  "name": "hub-provisioning-docker-local",
  "main": "provisioning-docker-worker.ts",
  "compatibility_date": "2024-04-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "../public", "binding": "ASSETS", "run_worker_first": true},
  "durable_objects": {"bindings": [{"name": "HUB", "class_name": "Hub"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Hub"]}],
  "vars": {
    "AUTH_BASE_URL": "https://auth.fake.local",
    "AUTH_CLIENT_ID": "fake-client",
    "AUTH_CALLBACK_URL": "http://localhost:19487/auth/callback",
    "AUTH_ISSUER": "https://auth.fake.local",
    "AUTH_JWKS_URL": "https://auth.fake.local/.well-known/jwks.json",
    "HUB_ADMINS": "admin@fake.local",
    "SESSION_SECRET": "local-docker-test-only-session-key-32-characters"
  }
}
