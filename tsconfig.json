{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": [
      "@cloudflare/workers-types",
      "node"
    ],
    "lib": [
      "ES2022"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "hub2/src/**/*.ts",
    "hub2/production-worker.ts",
    "hub2/node/**/*.ts"
  ]
}
