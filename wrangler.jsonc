{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-hub",
  "workers_dev": true,
  "main": "src/worker.ts",
  "compatibility_date": "2024-04-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HUB",
        "class_name": "Hub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Hub"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "*/30 * * * *",
      "*/5 * * * *"
    ]
  },
  "vars": {
    "SCHEMA_OBJECT_ROWID_HINTS": "{\"messages_bind_agents\":58,\"agents_no_legacy_collision_insert\":67,\"agents_no_legacy_collision_update\":68,\"fleet_launch_runtime_exit\":748,\"resource_catalog_fleet_sessions_update\":787,\"host_goal_running_insert\":628,\"host_goal_running_update\":629}",
    "HUB_ALERT_TO": "",
    "HUB_ALERT_WEBHOOK": "https://dapier.dtcdev.click/hooks/webhook/dev",
    "HUB_ADDITIONAL_ADMINS": "alexey@datatalks.club,orin@datatalks.club",
    "AUTH_CLIENT_ID": "1tplqm9l6q6545mrk0gjv6eaeh",
    "AUTH_ISSUER": "https://cognito-idp.us-east-1.amazonaws.com/us-east-1_H7nJu52Bs",
    "AUTH_BASE_URL": "https://auth.dtcdev.click",
    "AUTH_CALLBACK_URL": "https://hub.dtcdev.click/auth/callback",
    "AUTH_CALLBACK_URLS": "https://hub.dtcdev.click/auth/callback,https://agent-hub.cloudflare-ai-agent-de9ca0.workers.dev/auth/callback,http://localhost:19130/auth/callback",
    "AUTH_JWKS_URL": "https://cognito-idp.us-east-1.amazonaws.com/us-east-1_H7nJu52Bs/.well-known/jwks.json",
    "HUB_INTAKE_QUEUE_ENABLED": "true",
    "HUB_INTAKE_QUEUE_PROJECTS": "*",
    "HUB_INTAKE_QUEUE_MAX_INFLIGHT": "auto",
    "HUB_INTAKE_QUEUE_MAX_PER_PROJECT": "auto"
  },
  "dev": {
    "port": 19130
  }
}
