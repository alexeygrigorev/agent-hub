{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-hub",
  "main": "src/worker.ts",
  "compatibility_date": "2024-04-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HUB",
        "class_name": "Hub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Hub"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "*/30 * * * *"
    ]
  },
  "dev": {
    "port": 19130
  }
}
