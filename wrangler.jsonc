// Production is active after clean bootstrap and exact-head release checks.
// Bootstrap mode allows only auth, registry, account/quota setup and host
// pairing/heartbeats; maintenance mode serves health only.
// Install HUB2_CREDENTIAL_KEY, HUB2_BUDGET_ENVELOPES and alert secrets separately.
// 500ms is a configured policy, not a verified strict runtime upper bound.
// Active mode enables the approved 15-minute budget-alert cron.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-hub",
  "main": "hub2/production-worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_als"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "hub2/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTROL",
        "class_name": "ControlDO"
      },
      {
        "name": "PROJECTS",
        "class_name": "ProjectDO"
      },
      {
        "name": "MACHINES",
        "class_name": "MachineDO"
      },
      {
        "name": "ACCOUNTS",
        "class_name": "AccountDO"
      },
      {
        "name": "MAILBOXES",
        "class_name": "MailboxDO"
      },
      {
        "name": "BUDGET",
        "class_name": "BudgetDO"
      }
    ]
  },
  "exports": {
    "Hub": { "type": "durable-object", "state": "deleted" },
    "ControlDO": { "type": "durable-object", "storage": "sqlite" },
    "ProjectDO": { "type": "durable-object", "storage": "sqlite" },
    "MachineDO": { "type": "durable-object", "storage": "sqlite" },
    "AccountDO": { "type": "durable-object", "storage": "sqlite" },
    "MailboxDO": { "type": "durable-object", "storage": "sqlite" },
    "BudgetDO": { "type": "durable-object", "storage": "sqlite" }
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "limits": {
    "cpu_ms": 500,
    "subrequests": 64
  },
  "vars": {
    "HUB2_RELEASE_MODE": "active",
    "AUTH_CLIENT_ID": "1tplqm9l6q6545mrk0gjv6eaeh",
    "AUTH_ISSUER": "https://cognito-idp.us-east-1.amazonaws.com/us-east-1_H7nJu52Bs",
    "AUTH_BASE_URL": "https://auth.dtcdev.click",
    "AUTH_CALLBACK_URL": "https://hub.dtcdev.click/auth/callback",
    "AUTH_JWKS_URL": "https://cognito-idp.us-east-1.amazonaws.com/us-east-1_H7nJu52Bs/.well-known/jwks.json",
    "HUB_ADMINS": "alexey@datatalks.club,orin@datatalks.club"
  }
}
